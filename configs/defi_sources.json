{
  "version": "defi-2026-09-30-draft",
  "_note": "Same structure as configs/providers.json so cace_bench._walk_chain is reused unchanged. In the DeFi track the per-provider 'countries' map is keyed by CHAIN, and 'chains' maps chain -> source class -> fallback order. Every coverage and partial_rate figure is a working assumption (verified=false), not a vendor-confirmed number; a result published from this registry must say so.",
  "classes": {
    "onchain_state": "Positions, health factors, utilization, supply, pool reserves, oracle addresses — read via RPC/archive or an indexer. Screening-equivalent: without it no case is decidable.",
    "contract_meta": "Verified source, oracle configuration, timelock delay, multisig owners/threshold, upgradeability. Strong control verification.",
    "offchain_meta": "Protocol APIs, docs, curator reports, issuer reserve attestations. Weak control verification; issuer attestations may be structurally absent.",
    "market_depth": "Exit capacity at the position size: aggregator quotes live, pool reserves at a past block for the historical split."
  },
  "providers": {
